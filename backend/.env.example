# Copy to .env and fill in DB_PASSWORD.

# --- Local PostgreSQL (e.g. the one you manage in pgAdmin) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_brainloop_bci

# --- Paths (relative to backend/) ---
# Session data written by the API (CSV + recordings + camera frames)
DATA_DIR=../data
# Folder with the reel .mp4 files – paths in the CSV below are relative to it
VIDEOS_DIR=../dataset_videos
# Reels metadata – the `reels` table is refreshed from it on every start (edit the CSV, restart)
REELS_CSV=../dataset_videos/reels_metadata.csv

# --- EEG headset ---
# Connect the headset in BrainAccess Board (picked up automatically) or directly in the app (SDK).
# Optional: which Board stream to use when several headsets are connected (empty = first one)
EEG_LSL_STREAM=
# Accept Board streams from other computers on the network too (default false – ignores other teams)
EEG_LSL_ALLOW_REMOTE=false

CORS_ORIGINS=["http://localhost:5173","https://localhost:5173"]
