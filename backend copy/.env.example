# Copy to .env and fill in DB_PASSWORD.

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_brainloop_bci

# Paths are relative to backend/
# Session data written by the API (CSVs, recordings, camera frames, raw EEG)
DATA_DIR=../data
# Reel .mp4 files, paths in the CSV below are relative to this folder
VIDEOS_DIR=../dataset_videos
# Reel metadata, missing rows are added to the videos table on every start
REELS_CSV=../dataset_videos/reels_metadata.csv

# EEG headset. Connect it in BrainAccess Board (picked up automatically) or directly from the app.
# Which Board stream to use when several headsets are connected, empty means the first one
EEG_LSL_STREAM=
# Also accept Board streams from other machines on the network (off by default, ignores other teams)
EEG_LSL_ALLOW_REMOTE=false

CORS_ORIGINS=["http://localhost:5173","https://localhost:5173"]
